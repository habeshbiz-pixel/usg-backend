# ── Server ────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
ALLOWED_ORIGINS=https://your-frontend-domain.com

# ── Database (Neon.tech) ──────────────────────────────────
# Copy from Neon dashboard → Connection Details → Connection string
# Use the "pooled" connection string (ends in ?sslmode=require)
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# ── JWT ───────────────────────────────────────────────────
# Use a long random string — render.yaml auto-generates these on Render
JWT_SECRET=
JWT_REFRESH_SECRET=

# ── Stripe ────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_BASIC=price_...
STRIPE_PRICE_PLUS=price_...
STRIPE_PRICE_PREMIUM=price_...

# ── Twilio (optional — console fallback used if blank) ────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── AWS S3 (optional — mock fallback used in dev) ─────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=usg-uploads

# ── Firebase (optional — push logs to console if blank) ───
FIREBASE_SERVICE_ACCOUNT_JSON=
